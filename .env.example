# Copy to .env for local testing. In Unraid, set these as container variables instead.
FRIGATE_URL=https://10.0.0.138:8971
FRIGATE_USER=camui
FRIGATE_PASSWORD=change-me
# Frigate uses a self-signed certificate by default.
FRIGATE_INSECURE_TLS=true
# Optional: if set, all /api/* routes need "Authorization: Bearer <token>" (or ?token=).
LOOKOUT_TOKEN=
PORT=8080
